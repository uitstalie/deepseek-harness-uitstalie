{
  "name": "@deepseek-ai/dsh-workspace-tools",
  "description": "Workspace information toolset: sessions, dispatch tasks, intent cards, messages, and artifact references scoped to one registered workspace",
  "version": "0.2.2-rc.4",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:~"
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-dafeiyu": "workspace:*",
    "@deepseek-ai/dsh-error": "workspace:*",
    "@deepseek-ai/dsh-fs": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-session": "workspace:*",
    "@deepseek-ai/dsh-session-query": "workspace:*",
    "@deepseek-ai/dsh-store-atom": "workspace:*",
    "@deepseek-ai/dsh-tools": "workspace:*",
    "@deepseek-ai/dsh-workspace": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-agent-loop-testkit": "workspace:*",
    "@deepseek-ai/dsh-fs-local": "workspace:*",
    "@deepseek-ai/dsh-fs-sandbox": "workspace:*",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:*"
  }
}
