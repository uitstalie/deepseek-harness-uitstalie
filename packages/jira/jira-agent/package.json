{
  "name": "@deepseek-ai/dsh-jira-agent",
  "description": "The jira ledger's model surface: the jira_issue, jira_list and jira_kb tool runners and schemas, the caller guard, the /jira command and the bundled skills",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "skills"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-jira-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\""
  }
}
